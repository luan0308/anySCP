{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Talktoall Files",
  "version": "0.0.0-dev",
  "identifier": "br.com.talktoall.files",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "© 2026 talktoall. Baseado no anySCP © 2026 Nevil Macwan (MIT)",
    "category": "DeveloperTool",
    "shortDescription": "Seus servidores SSH, FTP e FTPS em um só lugar, com acesso pelo Claude",
    "longDescription": "Talktoall Files reúne terminal SSH, navegador de arquivos SFTP, FTP e FTPS e armazenamento S3 em um app só, com um servidor MCP para o Claude e o Codex trabalharem nos seus servidores sem ver as senhas. Baseado no anySCP, de Nevil Macwan, sob a licença MIT.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": "v1Compatible",
    "publisher": "talktoall",
    "windows": {
      "wix": {
        "language": "pt-BR"
      },
      "nsis": {
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "../LICENSE": "LICENSE.txt"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExMjY1REUyNkY0RDVDQjUKUldTMVhFMXY0bDBtRWM5d2Q1OHY3RWc1aHl4c0tYaFJjOGtGY1pSd2hrK0FRNkJzNkFzNi9GbEYK",
      "endpoints": [
        "https://github.com/luan0308/talktoall-files/releases/latest/download/latest.json"
      ]
    }
  },
  "mainBinaryName": "talktoall-files"
}
